{
  "name": "pro-track-backend",
  "version": "1.0.0",
  "description": "Backend API for Pro Track project tracker (Express + JWT + JSON store). Pure JavaScript — runs on any PC or Mac with Node.js, no build tools.",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.2"
  }
}
