# Copy this file to ".env" and change the values.
PORT=4000
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-secret

# Optional — powers the real AI Assistant chat (POST /api/ai/ask) with Claude.
# Without this, the app still works: the assistant falls back to its built-in
# rule-based answers. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
