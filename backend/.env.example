# Copy this file to ".env" and change the values.
PORT=4000
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-secret
# Server bind address. Defaults to 127.0.0.1 (localhost-only, not reachable from
# the network/internet). Set to 0.0.0.0 only when deploying behind a real host
# (Render/Railway/Fly.io) that needs to accept external traffic.
HOST=127.0.0.1
# Comma-separated list of browser origins allowed to call this API. Defaults to
# the local demo origins below; add your deployed frontend URL when the frontend
# and backend are hosted separately (e.g. https://your-app.netlify.app).
CORS_ORIGIN=http://localhost:4000,http://127.0.0.1:4000
